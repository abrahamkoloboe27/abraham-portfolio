# ============================================================================
#  Portfolio Abraham Z. KOLOBOE — variables d'environnement
#  Copiez ce fichier en `.env` et renseignez les valeurs.
#  `.env` est ignoré par git : n'y committez jamais de secret.
# ============================================================================

# ------------------------------------------------------------- application
ENVIRONMENT=development           # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

PUBLIC_SITE_URL=http://localhost:3000
ADMIN_SITE_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000

# ---------------------------------------------------------------- database
# Supabase : Project Settings → Database → Connection string → URI
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Neon : Dashboard → Connection Details
# Le préfixe est normalisé automatiquement en `postgresql+asyncpg://`.
DATABASE_URL=postgresql+asyncpg://portfolio:portfolio@localhost:5432/portfolio

# Utilisés uniquement par le Postgres local de docker-compose.yml
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio
POSTGRES_PORT=5432

# ---------------------------------------------------------------- sécurité
# Générez une valeur unique :  openssl rand -hex 32
SECRET_KEY=change-me-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Premier compte propriétaire, créé par `python -m app.db.seed`
FIRST_SUPERUSER_EMAIL=abklb27@gmail.com
FIRST_SUPERUSER_PASSWORD=ChangeMe!2026
FIRST_SUPERUSER_NAME=Abraham Zacharie KOLOBOE

# ---------------------------------------------------------------- stockage
# `local` = disque du conteneur API ; `s3` = Supabase Storage / MinIO / AWS S3
STORAGE_BACKEND=s3
MAX_UPLOAD_SIZE_MB=10

# Supabase Storage : Project Settings → Storage → S3 Connection
#   S3_ENDPOINT_URL=https://<ref>.supabase.co/storage/v1/s3
#   S3_PUBLIC_BASE_URL=https://<ref>.supabase.co/storage/v1/object/public
# MinIO local (docker-compose.yml) :
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_BASE_URL=http://localhost:9000
S3_BUCKET=portfolio-media
S3_ACCESS_KEY_ID=portfolio
S3_SECRET_ACCESS_KEY=portfolio123
S3_REGION=eu-west-3

# -------------------------------------------------------------------- mail
# Laissez vide pour désactiver l'envoi : les emails sont alors journalisés,
# et les liens d'invitation s'affichent directement dans l'administration.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAILS_FROM_EMAIL=no-reply@abrahamkoloboe.dev
EMAILS_FROM_NAME=Abraham Koloboe
CONTACT_NOTIFY_EMAIL=abklb27@gmail.com

# ------------------------------------------------------------ intégrations
GITHUB_USERNAME=abrahamkoloboe27
GITHUB_TOKEN=
YOUTUBE_API_KEY=

# ---------------------------------------------- déploiement auto-hébergé
# Utilisés par docker-compose.prod.yml + Caddy
DOMAIN=abrahamkoloboe.dev
ADMIN_DOMAIN=admin.abrahamkoloboe.dev
API_DOMAIN=api.abrahamkoloboe.dev
ACME_EMAIL=abklb27@gmail.com
REGISTRY=ghcr.io/abrahamkoloboe27/abraham-portfolio
TAG=latest

# --------------------------------------------------------------- frontends
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_REVALIDATE=300
VITE_API_URL=http://localhost:8000
VITE_SITE_URL=http://localhost:3000
